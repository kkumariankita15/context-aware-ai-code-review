{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1, "newProjectRoot": "projects",
  "projects": {"review-ui": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {"build": {"builder": "@angular-devkit/build-angular:application",
      "options": {"outputPath": "dist/review-ui", "index": "src/index.html",
        "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json",
        "styles": ["src/styles.css"]},
      "configurations": {"production": {"optimization": true, "sourceMap": false}},
      "defaultConfiguration": "production"},
    "serve": {"builder": "@angular-devkit/build-angular:dev-server",
      "configurations": {"production": {"buildTarget": "review-ui:build:production"},
        "development": {"buildTarget": "review-ui:build"}},
      "defaultConfiguration": "development"
    }
  }
}
},
"cli": {
"analytics": false
}
}
